<Window x:Class="SplitScreenWpfApp.ArcTests.ArcTestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intel® Core™ Ultra + Arc™ Graphics — исследование графики"
        Height="860" Width="1440" MinHeight="650" MinWidth="1100"
        Background="#111116" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BBBBC8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0071C5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="210"/>
        </Grid.RowDefinitions>

        <!-- Сведения о GPU -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="ИССЛЕДОВАНИЕ INTEL® CORE™ ULTRA С ГРАФИКОЙ INTEL® ARC™" Foreground="#4DA6FF" FontSize="17" FontWeight="Bold"/>
                <TextBlock x:Name="TxtGpuInfo" Text="Определение видеоадаптера…" Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="TxtGpuWarning" Foreground="#FFB84D" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus" Text="Подготовка…" Foreground="#4DA6FF" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Список тестов -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="1. Геометрия: треугольники в секунду" Foreground="#4DFF4D" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource CardText}"
                                       Text="Поле из освещённых сфер с бликами: от 50 тыс. до 3,5 млн треугольников. Показывает, где вершинный конвейер перестаёт держать частоту дисплея."/>
                            <Button x:Name="BtnTest1" Content="Запустить" Style="{StaticResource ActionButton}" Click="BtnTest1_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="2. Fill-rate: наложение полупрозрачных слоёв" Foreground="#E14DFF" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource CardText}"
                                       Text="От 16 до 1024 движущихся полноэкранных слоёв с градиентами и альфа-смешиванием. Нагружает пиксельные шейдеры и ROP; выводит оценку Гпикс/с."/>
                            <Button x:Name="BtnTest2" Content="Запустить" Style="{StaticResource ActionButton}" Click="BtnTest2_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="3. Поток текстур CPU → GPU" Foreground="#FF6B6B" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource CardText}"
                                       Text="Каждый кадр — новое изображение от 720p до 8K. Показывает ГБ/с и отдельно время работы CPU. У встроенной Arc видеопамяти нет — это проверка общей ОЗУ и того, как CPU и GPU делят её пропускную способность."/>
                            <Button x:Name="BtnTest3" Content="Запустить" Style="{StaticResource ActionButton}" Click="BtnTest3_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="4. Шарики: деление и аннигиляция" Foreground="#FFD24D" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource CardText}"
                                       Text="3D-шарики в кубе. Удар о стенку — шарик разлетается на два новых другого цвета. Друг с другом шарики упруго отскакивают, без деления. Каждый 10-й новый шарик — чёрно-белый: он уничтожает любой цветной шарик при столкновении. Каждые 2 с в журнал пишутся число шариков и FPS."/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Лимит шариков:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderMaxBalls" Minimum="100" Maximum="3000" Value="800"
                                        TickFrequency="100" IsSnapToTickEnabled="True" Width="130" Margin="8,0"
                                        VerticalAlignment="Center" ValueChanged="SliderMaxBalls_ValueChanged"/>
                                <TextBlock Text="{Binding Value, ElementName=SliderMaxBalls, StringFormat={}{0:0}}"
                                           Foreground="#FFD24D" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="BtnTest4" Content="Запустить (до «Остановить»)" Style="{StaticResource ActionButton}" Click="BtnTest4_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Button x:Name="BtnRunAll" Content="▶ Запустить все тесты" Style="{StaticResource ActionButton}" Margin="0" Click="BtnRunAll_Click"/>
                            <Button x:Name="BtnStop" Content="■ Остановить" Style="{StaticResource ActionButton}" Background="#5A2A2A" IsEnabled="False" Click="BtnStop_Click"/>
                            <Button x:Name="BtnCopy" Content="Копировать отчёт" Style="{StaticResource ActionButton}" Background="#333344" Click="BtnCopy_Click"/>
                            <TextBlock Style="{StaticResource CardText}"
                                       Text="Каждый тест идёт одновременно на обеих половинах, а FPS замеряется по очереди: пока меряется одна сторона, другая на паузе. У WPF один поток отрисовки на всё приложение, и при одновременном замере медленная левая половина тормозила бы правую. Тесты 1–3: на уровень 0,8 с прогрева + 3 с замера на каждую сторону. Тест 4: окна по 2 с поочерёдно; в общем прогоне — 60 с."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Сравнение: слева CPU (без Arc), справа GPU (Arc) -->
            <Grid Grid.Column="1" Margin="10,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,0,6">
                    <TextBlock Text="БЕЗ ARC™ GRAPHICS" Foreground="#FF6B6B" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="программный рендеринг WPF на процессоре" Foreground="#BBBBC8" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,0,6">
                    <TextBlock Text="С ARC™ GRAPHICS" Foreground="#4DFF4D" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="аппаратный рендеринг WPF на видеокарте" Foreground="#BBBBC8" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="HostCpu" Grid.Row="1" Grid.Column="0" Background="Black" BorderBrush="#5A2A2A" BorderThickness="1"/>
                <Border x:Name="HostGpu" Grid.Row="1" Grid.Column="2" Background="Black" BorderBrush="#2A5A2A" BorderThickness="1"/>
            </Grid>
        </Grid>

        <!-- Журнал результатов -->
        <TextBox x:Name="TxtLog" Grid.Row="2" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 Background="#0C0C10" Foreground="#DDDDDD" BorderBrush="#333"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>
    </Grid>
</Window>
